---
layout: layouts/base.njk
---
<section class="seite seite-schmal linkseite">
  <img class="linkseite-logo" src="/assets/img/logo.png" alt="Logo {{ site.name }}" width="190" height="120">
  <h1 class="seitentitel">{{ ueberschrift or title }}</h1>
  <ul class="linkliste">
    {%- for l in links %}
    <li><a href="{{ l.url }}"{% if "http" in l.url %} target="_blank" rel="noopener"{% endif %}>{{ l.titel }}</a></li>
    {%- endfor %}
  </ul>
</section>
